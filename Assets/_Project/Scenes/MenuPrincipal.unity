  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=150%><b><color=#F5C400>KUNTUR</color></b></size>\n<size=80%><cspace=0.35em>ECOS DEL VALLE</cspace></size>\n<size=60%><color=#BBBBBB>Proyecto Integrador de Videojuegos</color></size>\n\n\n\n<size=70%><color=#F5C400><cspace=0.3em>DESARROLLO Y DIRECCI\xD3N</cspace></color></size>\n\n<size=60%><color=#AAAAAA>Dise\xF1o de juego, programaci\xF3n y arte</color></size>\n<b>Junior Saul Ramirez Espiritu</b>\n\n<size=60%><color=#AAAAAA>Docente del curso</color></size>\nMiguel Torres Vargas\n\n<size=60%><color=#AAAAAA>Curso</color></size>\nDesarrollo de Videojuegos\n\n<size=60%><color=#AAAAAA>Carrera</color></size>\nIngenier\xEDa de Sistemas e Inform\xE1tica\n\n<size=60%><color=#AAAAAA>Instituci\xF3n</color></size>\nUniversidad Continental \xB7 Huancayo, Per\xFA\n\n\n\n<size=70%><color=#F5C400><cspace=0.3em>TECNOLOG\xCDA Y RECURSOS</cspace></color></size>\n\n<size=60%><color=#AAAAAA>Motor de desarrollo y programaci\xF3n</color></size>\nUnity 6 \xB7 C#\n\n<size=60%><color=#AAAAAA>Arte conceptual y modelo 3D del personaje</color></size>\nGoogle Gemini \xB7 Tripo AI\n\n<size=60%><color=#AAAAAA>Modelado y edici\xF3n 3D</color></size>\nBlender\n\n<size=60%><color=#AAAAAA>Rigging y animaciones 3D</color></size>\nMixamo (Adobe)\n\n<size=60%><color=#AAAAAA>Banda sonora y efectos de audio</color></size>\nPixabay \xB7 m\xFAsica andina y sonidos ambientales\n\n<size=60%><color=#AAAAAA>Recursos de la Unity Asset Store</color></size>\n<size=75%>City People FREE Samples (Denys Almaral) \xB7 ARCADE: FREE Racing Car (Mena)\nSimple Retro Car (Polyeler) \xB7 Ukraine only truck (KOS-store)\nGerman Shepherd 3D Model (RetroStyle Games) \xB7 Free chibi cat (Ladymito)\nCity Traffic Lights Pack \xB7 WasteOvergrowth \xB7 WaterWorks \xB7 AllSky Free\nNorthern Mountain FREE \xB7 Free Stylized Low Poly Tree \xB7 Modular Lowpoly Streets\nUnderwater Camera FX</size>\n\n\n\n<size=70%><color=#7BE3A0><cspace=0.3em>CONCIENCIA AMBIENTAL</cspace></color></size>\n\n<size=85%>Inspirado en la acumulaci\xF3n de residuos y la contaminaci\xF3n\nde los r\xEDos del Valle del Mantaro, Huancayo.\n\nUn proyecto para concientizar sobre la limpieza de nuestras calles,\nel cuidado del agua y la preservaci\xF3n de nuestro entorno.</size>\n\n<size=65%><color=#7DD3FC>ODS 6 \xB7 Agua limpia y saneamiento\nODS 11 \xB7 Ciudades y comunidades sostenibles</color></size>\n\n\n\n\n<size=90%><b>Gracias por jugar.</b></size>\n<size=65%><color=#BBBBBB>Cada bolsa que recoges es un r\xEDo que respira.</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
