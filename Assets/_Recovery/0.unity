  npcPortrait: {fileID: 0}
  openingLine: "\xA1Kuntur! Qu\xE9 bueno verte. Las heladas amenazan el valle y el r\xEDo Mantaro est\xE1 lleno de residuos. \xBFNos ayudas a diagnosticar el agua y limpiar el pueblo?"
  options:
  - text: "\xA1Por supuesto! Cuidemos el agua y nuestra comunidad."
    isCorrect: 1
    npcResponse: "\xA1Ese es el esp\xEDritu! Recoge los 6 residuos, toma 4 muestras en el r\xEDo y habla con Do\xF1a Rosa para que no contamine."
  - text: No es mi problema, solo estoy de paso.
    isCorrect: 0
    npcResponse: El valle nos necesita a todos... no podemos ser indiferentes.
  - text: Tal vez luego, ahora estoy ocupado.
    isCorrect: 0
    npcResponse: Cada minuto cuenta para salvar el valle del Mantaro.
  baseCorrectScore: 40
  correctHealthBonus: 8
  wrongHealthPenalty: 2
  objectiveId: hablar_con_yamile
