--- !u!114 &1340846178
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1340846176}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb2798e31eec93f48af99297ebac8056, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNPC
  npcName: "Do\xF1a Rosa"
  npcRole: "VECINA \xB7 BODEGUERA"
  npcPortrait: {fileID: 0}
  openingLine: "Ay hijito, esto siempre se ha botado aqu\xED... no creo que un poco de basura le haga tanto da\xF1o al r\xEDo."
  options:
  - text: "Do\xF1a Rosa, esa misma agua es la que despu\xE9s toman sus nietos."
    isCorrect: 1
    npcResponse: "...tienes raz\xF3n, no lo hab\xEDa pensado as\xED. Voy a guardar la basura para el cami\xF3n."
  - text: "\xA1Le va a caer una multa si sigue botando basura ah\xED!"
    isCorrect: 0
    npcResponse: "\xBFMulta? Ya vete de aqu\xED, no me vengas a amenazar."
  - text: No pasa nada, un poquito no afecta a nadie.
    isCorrect: 0
    npcResponse: Eso mismo pienso yo, hijito.
  baseCorrectScore: 40
  correctHealthBonus: 8
  wrongHealthPenalty: 2
  objectiveId: hablar_con_rosa
